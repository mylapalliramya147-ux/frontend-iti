# ITIAP Frontend — LOCAL overrides. NOT tracked by git.
# Copy this file:  cp .env.example .env
# then edit .env with YOUR OWN values. Never commit .env.
#
# Spring Boot loads .env automatically (see spring.config.import in
# src/main/resources/application.properties), and .env entries win over the
# defaults there. Environment variables win over .env if both are set.

# ── Backend base URL this UI talks to ──
BACKEND_URL=http://localhost:5050
