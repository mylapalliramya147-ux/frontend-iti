<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 4.1.x is the current supported OSS line: 4.0.x is superseded by 4.1.x, and
             the 3.5.x line reached end of OSS support on 2026-06-30 (commercial support
             ends 2032-06-30). The test sources already use the Spring Boot 4 API
             (org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc).
             4.1.1 is the latest stable 4.1.x patch (4.2.0-M1 is only a milestone). -->
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.server.frontend</groupId>
    <artifactId>frontend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>frontend</name>
    <description>AP ITI Frontend Application</description>
    <url>https://github.com/repo/frontend</url>
    <packaging>war</packaging>

    <properties>
        <java.version>21</java.version>
        <!-- Pin Lombok ahead of the Spring Boot BOM (which manages 1.18.46):
             RedHat java extension 1.57.x (Sept 2026) ships a newer ECJ/JDT where
             ConstructorDeclaration.constructorCall field changed, and Lombok <= 1.18.46
             crashes inside the IDE with:
             "NoSuchFieldError: ...ConstructorDeclaration ... constructorCall".
             1.18.48 (2026-09-01) is the current latest on Maven Central and supports
             the newer JDT/ECJ. Overriding <lombok.version> fixes both the dependency
             below and the annotationProcessorPaths entry (both use ${lombok.version}). -->
        <lombok.version>1.18.48</lombok.version>
        <!-- Declared as project properties (and not only inside maven-compiler-plugin) so
             IDE tooling derives the JavaSE-21 execution environment straight from the POM.
             spring-boot-starter-parent only defines maven.compiler.release, and m2e/JDT
             resolves the project compliance from maven.compiler.source/target; without these
             the IDE keeps a stale compliance level and reports
             "Project configuration is not up-to-date with pom.xml, requires an update". -->
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- 3.1.x is the springdoc line built against Spring Boot 4.1 / Spring
                 Framework 7 (3.0.x targeted Spring Boot 4.0, 2.8.x targeted 3.5.x).
                 Keep this in lock-step with the spring-boot-starter-parent version
                 above. -->
            <version>3.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- version comes from the Spring Boot BOM (${lombok.version}) -->
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <!-- Boot 4 moved the MockMvc slice-test support (AutoConfigureMockMvc /
                 WebMvcTest) out of spring-boot-starter-test into this starter, which is
                 where org.springframework.boot.webmvc.test.autoconfigure lives. -->
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- version is managed by spring-boot-starter-parent (kept out of the POM
                     so it tracks the Spring Boot release instead of drifting behind it) -->
                <configuration>
                    <!-- No <release>/<source>/<target> here on purpose: the
                         maven.compiler.* properties in <properties> above are the single
                         source of truth, so javac and IDE tooling (m2e/JDT) can never drift
                         apart from each other. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <!-- ${lombok.version} is defined by the Spring Boot BOM, so the
                                 annotation processor can never drift from the lombok dependency -->
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <!-- kept in lock-step with the parent to avoid version drift -->
                            <version>${project.parent.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
